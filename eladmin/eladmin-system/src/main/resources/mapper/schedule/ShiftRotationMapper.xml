<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="me.zhengjie.modules.schedule.mapper.ShiftRotationMapper">
    <resultMap id="BaseResultMap" type="me.zhengjie.modules.schedule.domain.ShiftRotation">
        <id column="rotation_id" property="id"/>
        <result column="name" property="name"/>
        <result column="code" property="code"/>
        <result column="type" property="type"/>
        <result column="cycle_days" property="cycleDays"/>
        <result column="rotation_pattern" property="rotationPattern"/>
        <result column="rest_days" property="restDays"/>
        <result column="dept_id" property="deptId"/>
        <result column="user_ids" property="userIds"/>
        <result column="dept_ids" property="deptIds"/>
        <result column="start_date" property="startDate"/>
        <result column="end_date" property="endDate"/>
        <result column="enabled" property="enabled"/>
        <result column="remark" property="remark"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        rotation_id, name, code, type, cycle_days, rotation_pattern, rest_days,
        dept_id, user_ids, dept_ids, start_date, end_date, enabled, remark,
        create_by, update_by, create_time, update_time
    </sql>

    <sql id="Where_Sql">
        <where>
            <if test="criteria.id != null">
                and rotation_id = #{criteria.id}
            </if>
            <if test="criteria.type != null and criteria.type != ''">
                and type = #{criteria.type}
            </if>
            <if test="criteria.deptId != null">
                and dept_id = #{criteria.deptId}
            </if>
            <if test="criteria.enabled != null">
                and enabled = #{criteria.enabled}
            </if>
            <if test="criteria.blurry != null and criteria.blurry != ''">
                and (
                name like concat('%', #{criteria.blurry}, '%')
                or code like concat('%', #{criteria.blurry}, '%')
                )
            </if>
            <if test="criteria.createTime != null and criteria.createTime.size() == 2">
                and create_time between #{criteria.createTime[0]} and #{criteria.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="findAll" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from sch_shift_rotation
        <include refid="Where_Sql"/>
        order by rotation_id desc
        <if test="criteria.offset != null">
            limit #{criteria.offset}, #{criteria.size}
        </if>
    </select>

    <select id="countAll" resultType="java.lang.Long">
        select count(*)
        from sch_shift_rotation
        <include refid="Where_Sql"/>
    </select>

    <select id="findByCode" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from sch_shift_rotation
        where code = #{code}
    </select>

    <select id="findByDeptId" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from sch_shift_rotation
        where dept_id = #{deptId} and enabled = 1
        order by rotation_id asc
    </select>

    <select id="findByEnabled" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from sch_shift_rotation
        where enabled = #{enabled}
        order by rotation_id desc
    </select>
</mapper>