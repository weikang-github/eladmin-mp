<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="me.zhengjie.modules.schedule.mapper.ScheduleRuleMapper">
    <resultMap id="BaseResultMap" type="me.zhengjie.modules.schedule.domain.ScheduleRule">
        <id column="rule_id" property="id"/>
        <result column="name" property="name"/>
        <result column="type" property="type"/>
        <result column="expression" property="expression"/>
        <result column="priority" property="priority"/>
        <result column="enabled" property="enabled"/>
        <result column="remark" property="remark"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        rule_id, name, type, expression, priority, enabled, remark,
        create_by, update_by, create_time, update_time
    </sql>

    <sql id="Where_Sql">
        <where>
            <if test="criteria.id != null">
                and rule_id = #{criteria.id}
            </if>
            <if test="criteria.blurry != null and criteria.blurry != ''">
                and (name like concat('%', #{criteria.blurry}, '%') or remark like concat('%', #{criteria.blurry}, '%'))
            </if>
            <if test="criteria.type != null and criteria.type != ''">
                and type = #{criteria.type}
            </if>
            <if test="criteria.enabled != null">
                and enabled = #{criteria.enabled}
            </if>
            <if test="criteria.createTime != null and criteria.createTime.size() == 2">
                and create_time between #{criteria.createTime[0]} and #{criteria.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="findAll" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from sch_schedule_rule
        <include refid="Where_Sql"/>
        order by priority asc, create_time desc
    </select>

    <select id="countAll" resultType="java.lang.Long">
        select count(*) from sch_schedule_rule
        <include refid="Where_Sql"/>
    </select>

    <select id="findByType" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from sch_schedule_rule
        where type = #{type} and enabled = 1
        order by priority asc
    </select>

    <select id="findEnabledRules" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from sch_schedule_rule
        where enabled = 1
        order by priority asc
    </select>
</mapper>
