<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="me.zhengjie.modules.schedule.mapper.ScheduleConflictMapper">

    <resultMap id="BaseResultMap" type="me.zhengjie.modules.schedule.domain.ScheduleConflict">
        <id column="conflict_id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="shift_date" property="shiftDate"/>
        <result column="conflict_type" property="conflictType"/>
        <result column="conflict_desc" property="conflictDesc"/>
        <result column="related_shift_id" property="relatedShiftId"/>
        <result column="status" property="status"/>
        <result column="resolved_by" property="resolvedBy"/>
        <result column="resolved_time" property="resolvedTime"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        
        <association property="user" javaType="me.zhengjie.modules.system.domain.User">
            <id column="user_id" property="id"/>
            <result column="username" property="username"/>
            <result column="nick_name" property="nickName"/>
        </association>
    </resultMap>

    <sql id="Base_Column_List">
        sc.conflict_id, sc.user_id, sc.shift_date, sc.conflict_type, sc.conflict_desc,
        sc.related_shift_id, sc.status, sc.resolved_by, sc.resolved_time, sc.remark, sc.create_time,
        u.username, u.nick_name
    </sql>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM schedule_conflict sc
        LEFT JOIN sys_user u ON sc.user_id = u.user_id
        <where>
            <if test="criteria.userId != null">
                AND sc.user_id = #{criteria.userId}
            </if>
            <if test="criteria.startDate != null">
                AND sc.shift_date &gt;= #{criteria.startDate}
            </if>
            <if test="criteria.endDate != null">
                AND sc.shift_date &lt;= #{criteria.endDate}
            </if>
            <if test="criteria.conflictType != null and criteria.conflictType != ''">
                AND sc.conflict_type = #{criteria.conflictType}
            </if>
            <if test="criteria.status != null and criteria.status != ''">
                AND sc.status = #{criteria.status}
            </if>
        </where>
        ORDER BY sc.create_time DESC
    </select>

    <select id="findUnresolved" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM schedule_conflict sc
        LEFT JOIN sys_user u ON sc.user_id = u.user_id
        WHERE sc.status = 'UNRESOLVED'
        <if test="userId != null">
            AND sc.user_id = #{userId}
        </if>
        ORDER BY sc.shift_date
    </select>

</mapper>
